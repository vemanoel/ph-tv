FROM docker.io/library/debian@sha256:2dc419c6d7fe3dad0a2f9fd469c34cc90b0f9ba642d8fde837fe3d7d34a0e7f1

USER root

RUN apt-get update

RUN apt-get install --yes ncurses-bin
RUN apt-get install --yes nodejs npm
RUN apt-get install --yes openjdk-21-jdk

RUN useradd --create-home developer

USER developer
